# Copy to .env.local and fill in. Never commit real keys.

# Supabase Postgres connection string (server-only, never exposed to the browser).
# Supabase → your project → "Connect" → Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Public site URL used in QR codes, share links and redirects.
NEXT_PUBLIC_SITE_URL=https://padiup.example.com

# Player sessions and the rotating entrance codes (openssl rand -hex 32).
QUEST_SESSION_SECRET=

# The circle this deployment runs (lowercase slug). Create it from the admin page on first run;
# its event day, socials, community link and hashtags are set in circle admin (/c/<slug>/admin).
PADIUP_CIRCLE=my-event-2026
# Google sign-in runs through Supabase Auth (Project Settings → API).
# In Supabase: Authentication → Providers → Google on, and add
# <NEXT_PUBLIC_SITE_URL>/auth/callback under Authentication → URL Configuration → Redirect URLs.
# Without these, local dev shows an email-only sign-in page instead.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# sb_publishable_… (a legacy anon key also works, as NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin (all three required; otherwise the admin area returns 404).
# Secret URL segment → https://yoursite/<ADMIN_PATH>. Make it unguessable.
ADMIN_PATH=ops-change-me-7Kq9x2
# Owners with their own 6–12 digit PIN, comma separated. Owners are organisers of every circle.
ADMIN_USERS=you@example.com:482913,teammate@example.com:771204
# Long random string for signing admin sessions (openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Hall screen lives at /hall?key=<this>. Make it unguessable: it shows the check-in QR.
QUEST_HALL_KEY=
# X API (developer.x.com, pay-per-use) app-only bearer token: verifies posts for the +5 mission.
X_BEARER_TOKEN=
# Protects /api/cron (X search every 15 min, deleted-post recheck daily). See db/quest-cron.sql.
CRON_SECRET=
# Optional: force a phase (pre | event | post) to test venue features. Remove after.
# Otherwise the circle's event day decides it.
QUEST_PHASE=

# Cloudinary: player profile photos and partner logos.
# Server-only: uploads are signed here, the secret never reaches the browser. Without all three, upload buttons are hidden.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
